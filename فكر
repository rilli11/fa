<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>اكتشف العلاقة | الابتكار وريادة الأعمال</title>
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);--bg:#ecfaff;--card:#fff;--ink:#0b2b3a;--mute:#527080;--line:#cfe8f1;--pri:#0891b2;--pri2:#06b6d4;--gold:#f59e0b}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){color-scheme:dark;--bg:#07222d;--card:#0d3140;--ink:#e6f6fb;--mute:#8fb4c2;--line:#1b4a5c;--pri:#22d3ee;--pri2:#0891b2;--gold:#fbbf24}}
:root[data-theme="dark"]{color-scheme:dark;--bg:#07222d;--card:#0d3140;--ink:#e6f6fb;--mute:#8fb4c2;--line:#1b4a5c;--pri:#22d3ee;--pri2:#0891b2;--gold:#fbbf24}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:Tajawal,system-ui,sans-serif;line-height:1.6}
.wrap{max-width:720px;margin:0 auto;padding:16px}
.brand{text-align:center;font-weight:700;color:var(--mute);font-size:13px;margin-bottom:10px}
.card{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:20px;box-shadow:0 6px 24px rgba(8,145,178,.1)}
h1{font-size:30px;margin:4px 0;font-weight:800;text-align:center}
.sub{color:var(--mute);text-align:center;margin:0 0 14px}
.btn{display:block;width:100%;border:0;border-radius:14px;padding:14px;font:inherit;font-weight:700;font-size:17px;cursor:pointer;background:linear-gradient(135deg,var(--pri2),var(--pri));color:#fff;margin-top:12px}
.btn.alt{background:var(--bg);color:var(--pri);border:2px solid var(--line)}
.btn:disabled{opacity:.4;cursor:default}
.boxes{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:8px}
.box{border:2px dashed var(--line);border-radius:18px;padding:14px 8px;text-align:center;background:var(--bg);min-height:230px;display:flex;flex-direction:column;justify-content:space-between}
.box.on{border-style:solid;border-color:var(--pri)}
.lbl{font-size:13px;color:var(--mute);font-weight:700}
.face{font-size:44px;margin:6px 0}.face b{display:block;font-size:18px}.face small{display:block;font-size:13px;color:var(--mute);font-weight:500;line-height:1.5;margin-top:4px}.defs{font-size:14px;color:var(--mute);margin:8px 0;line-height:1.7}
.box.spin .face{animation:sh .18s infinite}
@keyframes sh{50%{transform:translateY(-6px) rotate(3deg)}}
@keyframes pop{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.card>*{animation:pop .35s both}
.mini{background:var(--card);color:var(--pri);border:1px solid var(--line);border-radius:12px;padding:8px;font:inherit;font-weight:700;cursor:pointer}
.mini:disabled{opacity:.4}
.tag{display:inline-block;background:var(--bg);color:var(--pri);border-radius:20px;padding:2px 12px;font-size:13px;font-weight:700}
.q{font-size:21px;font-weight:800;line-height:1.7;margin:12px 0;padding:16px;border-radius:16px;background:var(--bg);border-inline-start:5px solid var(--pri)}
.mascot{display:flex;gap:12px;align-items:center;margin:10px 0}
.mascot>div:last-child{background:var(--bg);border-radius:18px;padding:10px 14px}
.bola{width:64px;flex:none;filter:drop-shadow(0 6px 8px rgba(8,60,80,.3));animation:bob 2.6s ease-in-out infinite}
.bola.big{width:110px;display:block;margin:0 auto 4px}
@keyframes bob{50%{transform:translateY(-6px) rotate(-2deg)}}
textarea{width:100%;min-height:90px;border:2px solid var(--line);border-radius:14px;padding:12px;font:inherit;background:var(--bg);color:var(--ink);resize:vertical}
.idea{background:var(--bg);border-radius:16px;padding:14px;margin:10px 0;font-size:18px;font-weight:700}
.quote{text-align:center;font-weight:700;color:var(--pri);padding:12px;border:2px dashed var(--line);border-radius:16px;margin:12px 0}
.star{position:fixed;bottom:-50px;z-index:50;pointer-events:none;animation:fly 2.8s ease-in forwards}
@keyframes fly{to{transform:translate(var(--dx),-115vh) rotate(40deg);opacity:0}}
.mu{position:fixed;top:calc(env(safe-area-inset-top,0px) + 10px);left:12px;z-index:20;width:42px;height:42px;border-radius:50%;border:1px solid var(--line);background:var(--card);font-size:20px;cursor:pointer}
@media (prefers-reduced-motion:reduce){.star{display:none}.bola{animation:none}}
.era{font-size:13px;color:var(--mute);text-align:center;margin-top:14px}
</style>
</head>
<body>
<button class="mu" id="mu" onclick="toggleMusic()" aria-label="الموسيقى">🔊</button>
<div class="wrap">
<div class="brand">✦ نادي الابتكار وريادة الأعمال</div>
<div class="card" id="app"></div>
<p class="era">كل ابتكار يبدأ بسؤال، وكل سؤال علمي قد يقود إلى اكتشاف جديد.</p>
</div>
<script>
const BOLA="data:image/webp;base64,";
const TECH=[["🤖","الروبوتات","آلات تنفّذ مهام بدل الإنسان وبدقة عالية"],["🧠","الذكاء الاصطناعي","أنظمة تتعلّم من البيانات وتتخذ قرارات تشبه تفكير الإنسان"],["📡","إنترنت الأشياء","أجهزة متصلة بالإنترنت ترسل بياناتها وتتبادلها"],["👁️","الرؤية الحاسوبية","تعليم الحاسوب أن يرى الصور والفيديو ويفهمها"],["🪞","التوأم الرقمي","نسخة افتراضية من شيء حقيقي لمراقبته وتجربته"],["📊","تحليل البيانات","استخراج الأنماط والنتائج المفيدة من الأرقام"]];
const FIELD=[["🏥","الطب","علم تشخيص الأمراض وعلاجها والوقاية منها"],["🏗️","الهندسة","تصميم وبناء المنشآت والأنظمة لحل مشكلات عملية"],["🌿","البيئة","دراسة الطبيعة وطرق الحفاظ عليها"],["🌾","الزراعة","إنتاج المحاصيل والغذاء من الأرض"],["🎓","التعليم","نقل المعرفة والمهارات وتنمية التعلّم"],["⚡","الطاقة","مصادر الكهرباء والوقود وطرق توفيرها"]];
const PR=["فكرة رائعة! فكّرت مثل مبتكر حقيقي 🌟","ممتاز! هذا النوع من الأفكار اللي نبيه 👏","أحسنت! فكرتك تستحق التجربة 🎯","فكرة قوية! ممكن تصير بحثًا علميًا 🔬"];
const s={t:null,f:null,spin:null,view:"draw",idea:"",pr:0};
const $=id=>document.getElementById(id),app=$("app");
const esc=t=>(t||"").replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const av=big=>`<img class="bola${big?" big":""}" src="${BOLA}" alt="بولا">`;
const rnd=n=>Math.floor(Math.random()*n);
const pair=()=>`${TECH[s.t][0]} ${TECH[s.t][1]} + ${FIELD[s.f][0]} ${FIELD[s.f][1]}`;

function box(k){
 const a=k=="t"?TECH:FIELD,i=s[k];
 return `<div class="box ${i!=null?"on":""} ${s.spin==k?"spin":""}"><div class="lbl">${k=="t"?"📦 صندوق التقنيات":"📦 صندوق المجالات"}</div>
 <div class="face">${i==null?"❓":a[i][0]+"<b>"+a[i][1]+"</b><small>"+a[i][2]+"</small>"}</div>
 <button class="mini" ${s.spin?"disabled":""} onclick="draw('${k}')">${i==null?"اسحب":"بدّل البطاقة"}</button></div>`;
}
function draw(k){
 const n=(k=="t"?TECH:FIELD).length;let c=0;s.spin=k;
 const iv=setInterval(()=>{s[k]=rnd(n);tick(c);show();if(++c>9){clearInterval(iv);s.spin=null;pop();show()}},90);
}
function show(){
 if(s.view=="draw"){
  const ok=s.t!=null&&s.f!=null&&!s.spin;
  app.innerHTML=`${av(1)}<h1>اكتشف العلاقة 🔬</h1><p class="sub">أنا بولا! اسحب بطاقة من كل صندوق<br>مثال: الروبوتات + الطب = روبوت يساعد في العمليات الجراحية</p>
  <div class="boxes">${box("t")}${box("f")}</div>
  <button class="btn" ${ok?"":"disabled"} onclick="go('q')">اكتشف العلاقة ←</button>`;
 }else if(s.view=="q"){
  app.innerHTML=`<span class="tag">${pair()}</span>
  <div class="q">كيف يمكن استخدام ${TECH[s.t][1]} في مجال ${FIELD[s.f][1]}؟</div>
  <div class="defs"><b>${TECH[s.t][1]}:</b> ${TECH[s.t][2]}<br><b>${FIELD[s.f][1]}:</b> ${FIELD[s.f][2]}</div>
  <div class="mascot">${av()}<div><b>بولا</b><br>اكتب فكرتك بجملة وحدة.</div></div>
  <textarea id="idea" placeholder="فكرتي: ...">${esc(s.idea)}</textarea>
  <button class="btn" onclick="send()">أرسل فكرتي 🚀</button>
  <button class="btn alt" onclick="go('draw')">↻ أعد السحب</button>`;
 }else{
  app.innerHTML=`<div class="mascot">${av()}<div><b>بولا</b><br>${PR[s.pr]}</div></div>
  <span class="tag" style="color:var(--gold)">🏅 +10 نقاط مبتكر</span>
  <div class="idea">${pair()}<br><span style="font-weight:500">${esc(s.idea)}</span></div>
  <div class="quote">كل ابتكار يبدأ بسؤال، وكل سؤال علمي قد يقود إلى اكتشاف جديد.</div>
  <button class="btn" id="cp" onclick="share()">📋 انسخ فكرتي</button>
  <button class="btn alt" onclick="reset()">زائر جديد ↻</button>`;
 }
}
function go(v){s.view=v;show()}
function send(){
 const v=$("idea").value.trim();
 if(v.length<3){$("idea").style.borderColor="var(--gold)";$("idea").placeholder="اكتب فكرتك أولًا 🙂";return}
 s.idea=v;s.pr=rnd(PR.length);party();go("r");
}
function share(){
 const b=$("cp"),x=`اكتشف العلاقة: ${TECH[s.t][1]} + ${FIELD[s.f][1]}\nفكرتي: ${s.idea}`;
 try{navigator.clipboard.writeText(x).then(()=>b.textContent="تم النسخ ✓").catch(()=>b.textContent="انسخ النص يدويًا")}catch(e){b.textContent="انسخ النص يدويًا"}
}
function reset(){s.t=s.f=null;s.idea="";s.view="draw";show()}

/* الصوت والموسيقى مولَّدة داخل الصفحة */
let AC=null,musicOn=true,mT=null,st=0;
const SC=[261.63,293.66,329.63,392,440,523.25,587.33,659.25],MEL=[0,2,4,2,5,4,2,1,0,2,4,7,5,4,2,4];
function ctx(){if(!AC){try{AC=new(window.AudioContext||window.webkitAudioContext)()}catch(e){}}if(AC&&AC.state=="suspended")AC.resume();return AC}
function note(f,t,d,v,ty){const c=ctx();if(!c)return;const o=c.createOscillator(),g=c.createGain(),n=c.currentTime+t;o.type=ty||"sine";o.frequency.value=f;g.gain.setValueAtTime(.0001,n);g.gain.linearRampToValueAtTime(v,n+.02);g.gain.exponentialRampToValueAtTime(.0001,n+d);o.connect(g);g.connect(c.destination);o.start(n);o.stop(n+d+.05)}
function tick(i){if(musicOn)note(500+i*60,0,.08,.05,"triangle")}
function pop(){if(musicOn){note(660,0,.15,.09,"triangle");note(880,.08,.2,.07,"triangle")}}
function startMusic(){if(mT||!musicOn)return;ctx();mT=setInterval(()=>{const f=SC[MEL[st%MEL.length]];note(f,0,.7,.03);if(st%4==0)note(f/2,0,1.4,.025,"triangle");st++},420)}
function toggleMusic(){musicOn=!musicOn;$("mu").textContent=musicOn?"🔊":"🔇";if(musicOn)startMusic();else{clearInterval(mT);mT=null}}
document.addEventListener("pointerdown",startMusic,{once:true});

/* موسيقى الفوز: فانفار نحاسي قصير */
function brass(f,t,d,v){
 const c=ctx();if(!c)return;
 const o=c.createOscillator(),l=c.createBiquadFilter(),g=c.createGain(),n=c.currentTime+t;
 o.type="sawtooth";o.frequency.value=f;l.type="lowpass";l.frequency.setValueAtTime(700,n);l.frequency.linearRampToValueAtTime(2200,n+.08);
 g.gain.setValueAtTime(.0001,n);g.gain.linearRampToValueAtTime(v,n+.03);g.gain.setValueAtTime(v,n+d*.7);g.gain.exponentialRampToValueAtTime(.0001,n+d);
 o.connect(l);l.connect(g);g.connect(c.destination);o.start(n);o.stop(n+d+.05);
}
function winSound(){
 if(!musicOn)return;
 [[392,0,.12],[392,.16,.12],[392,.32,.12],[523.25,.5,.55],[440,1.12,.14],[523.25,1.32,1.2],[659.25,1.32,1.2],[783.99,1.32,1.2]].forEach(([f,t,d])=>brass(f,t,d,.05));
 [1046.5,1318.5,1568].forEach((f,i)=>note(f,1.35+i*.06,.9,.04));
}
/* احتفال: نجمة واحدة الشكل تطير للأعلى */
function party(){
 winSound();
 for(let i=0;i<12;i++){const e=document.createElement("span");e.className="star";e.textContent="⭐";
  e.style.left=(5+Math.random()*90)+"%";e.style.fontSize=(22+Math.random()*22)+"px";e.style.animationDelay=(Math.random()*.7)+"s";
  e.style.setProperty("--dx",(Math.random()*80-40)+"px");document.body.appendChild(e);setTimeout(()=>e.remove(),3800)}
}
show();
</script>
</body>
</html>
